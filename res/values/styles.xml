<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="StartupTheme" parent="@style/AppTheme">
        <!-- 非透明启动页，确保冷启动从竖屏桌面直接进入横屏，避免透明 Window 继承桌面竖屏方向 -->
    </style>

    <style name="PlayerTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
